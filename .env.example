# ---------------------------------------------------------------------------
# Bull Lab Trading System — variabili d'ambiente per la produzione
# Copia questo file in .env.local (o nelle Environment Variables dell'hosting)
# ---------------------------------------------------------------------------

# 1) Database PostgreSQL (Neon / Supabase / Postgres del VPS)
#    Deve essere l'URL "pooled" se il provider lo offre.
DATABASE_URL=postgresql://utente:password@host:5432/bulllab?sslmode=require

# 2) Indirizzo pubblico definitivo del cruscotto (senza slash finale)
#    Usato per generare l'URL del webhook TradingView.
NEXT_PUBLIC_APP_URL=https://bot.bulllab.one

# 3) Protezione opzionale del cruscotto (HTTP Basic Auth).
#    Se mancano entrambe, il cruscotto resta aperto.
#    Il webhook /api/webhook/tradingview e /api/health restano sempre pubblici.
DASHBOARD_USER=asintomatico
DASHBOARD_PASSWORD=cambia-questa-password-lunga

# Nota: le chiavi API degli exchange NON vanno qui.
# Vengono inserite dalla scheda "Vai Live (Facile)" e salvate nel database,
# mascherate a schermo e usate solo lato server.
